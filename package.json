{
  "name": "jala-ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "workers/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev:web": "npm run dev --workspace @jala-ops/web",
    "dev:api": "npm run dev --workspace @jala-ops/api",
    "dev:mobile": "npm run start --workspace @jala-ops/mobile",
    "typecheck": "npm run typecheck --workspaces && tsc -p tsconfig.tools.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build:api && vitest run",
    "build:api": "npm run build --workspace @jala-ops/api",
    "build": "npm run build --workspaces",
    "db:migrate": "npm run db:migrate --workspace @jala-ops/api",
    "db:seed": "npm run db:seed --workspace @jala-ops/api"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260920.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "miniflare": "^5.20260918.0-alpha",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  }
}
