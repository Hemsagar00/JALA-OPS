{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "jala-ops-api-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": {
    "APP_ENV": "local",
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jala-ops-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../database/migrations",
    },
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "jala-ops-photos-local" }],
  "observability": { "enabled": true },
}
