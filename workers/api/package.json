{
  "name": "@jala-ops/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@jala-ops/constants": "0.1.0",
    "@jala-ops/types": "0.1.0",
    "@jala-ops/validation": "0.1.0"
  },
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir ../../.artifacts/api",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "wrangler d1 execute DB --local --file ../../database/seed/development.sql"
  }
}
